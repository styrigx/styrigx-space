---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import SitesSection from '@components/sections/portal/SitesSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import heroImage from '@images/hero-image.avif';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/** The personal portal home page. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;

const sites = [
  {
    title: 'Blog',
    description: 'Sloan Gray 的个人博客 · Astro + 中英双语',
    url: 'https://blog.styrigx.com',
    icon: 'books' as const,
  },
  {
    title: 'Muse Invite Board',
    description: 'Muse 邀请码免费共享站 · 网友互助',
    url: 'https://muse-invite.styrigx.com',
    icon: 'sparks' as const,
  },
  {
    title: 'GitHub',
    description: '@styrigx · 开源项目与代码',
    url: 'https://github.com/styrigx',
    icon: 'githubMark' as const,
  },
  {
    title: 'X',
    description: '@styrigx · 日常动态',
    url: 'https://x.com/styrigx',
    icon: 'x' as const,
  },
];
---

<MainLayout>
  <HeroSection
    title={copy.hero.title}
    subTitle={copy.hero.subTitle}
    primaryBtn={copy.hero.primaryBtn}
    primaryBtnURL="https://blog.styrigx.com"
    secondaryBtn={copy.hero.secondaryBtn}
    secondaryBtnURL="https://github.com/styrigx"
    src={heroImage}
    alt={copy.hero.imageAlt}
  />

  <SitesSection
    title={copy.sites.title}
    subTitle={copy.sites.subTitle}
    sites={sites}
  />

  <FAQ title={copy.faqTitle} faqs={t.data.faqs} />
</MainLayout>
