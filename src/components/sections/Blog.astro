---
import Glyph from '@/components/ui/Glyph.astro'
import SectionHead from '@/components/ui/SectionHead.astro'
import { LINKS, t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
  num: string
}

const { lang, num } = Astro.props
const { blog, a11y } = t(lang)
---

<div
  class="col col--projects reveal"
  id="blog"
  aria-labelledby="blog-title"
>
  <SectionHead num={num} title={blog.title} id="blog-title" />
  <p class="blog__lead">{blog.lead}</p>
  <div class="projects">
    {blog.posts.map((post, i) => (
      <a
        class="project"
        href={post.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="project__index">{String(i + 1).padStart(2, '0')}</span>
        <span class="project__name">
          {post.title}
        </span>
        <span class="project__date">{post.date}</span>
        <Glyph name="arrow" class="arrow" />
        <span class="sr-only">{a11y.external}</span>
      </a>
    ))}
  </div>
  <p class="col__foot">
    <a
      class="btn btn--outline"
      href={LINKS.blog}
      target="_blank"
      rel="noopener noreferrer"
    >
      {blog.visit}
      <Glyph name="arrow" class="arrow btn__arrow" />
      <span class="sr-only">{a11y.external}</span>
    </a>
  </p>
</div>

<style>
  .blog__lead {
    margin-bottom: var(--space-4);
    color: var(--color-muted);
  }
  .project__date {
    margin-left: auto;
    font-size: 0.85em;
    color: var(--color-muted);
  }
</style>
