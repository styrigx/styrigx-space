# Cloudflare Pages 静态响应头（Pages 的 _worker.js 用 env.ASSETS 回静态文件时也照这里加）。
#
# 合并规则（CF 文档）：一个路径命中几条规则就继承几条的头，同名头用逗号拼起来。
# 所以 Cache-Control 只写在互不重叠的具体路径上，/* 里不写（以前 /* 也写了 max-age=300，
# /css/* 等会拼成「public, max-age=31536000, immutable, public, max-age=300」，自相矛盾）。
# 没列出的路径（页面 HTML、files-index.json、RSS 等）用 Pages 默认的 max-age=0, must-revalidate；
# 页面经网关回源后网关一律改成 private, no-store（防浏览器缓存绕过锁屏）。
#
# 安全头（/* 那一段）由 space/scripts/gen-csp.mjs 生成，值的唯一来源是
# workers/auth-gateway/src/lib/security-headers.js；网关、账号 Worker、分享 Worker 发的是同一套。

# @gen-security-headers start（space/scripts/gen-csp.mjs 按 workers/auth-gateway/src/lib/security-headers.js 生成，别手改）
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), serial=(), hid=(), midi=(), display-capture=()
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-3cnYCRXIA6PvNuskoomZSRzThARfCNNwL5rAwESJLec=' 'sha256-8VUtGt0XIM4tq5fcxylnFZh69yjnX/awyECKE17VkgY=' 'sha256-DjLbe/hIQ8AZ8+YKxUVrYfDKWmoONJdHxEdJjAuRWPY=' 'sha256-EXXy0XPvXTtUhwj3HaX4YeIspqPULX4vksSB4X+ltm4=' 'sha256-T6Fz6qMxIX4cZu6g8nyrxF5x4oHtNW/ow17xcKbgVRM=' 'sha256-i1XMiEvbVUtdwdw3UvJJ8q9wEIV5cxYfeWksDFT51NY='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com; frame-src 'none'; worker-src 'none'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
# @gen-security-headers end

/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/fav/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=300
/avatar/*
  Cache-Control: public, max-age=300
/favicon.ico
  Cache-Control: public, max-age=300
/favicon.svg
  Cache-Control: public, max-age=300
/og.png
  Cache-Control: public, max-age=300
/robots.txt
  Cache-Control: public, max-age=300
/sitemap.xml
  Cache-Control: public, max-age=300

# 子站（2026-11 合站起和主站是同一个 Hugo 站，产物在同一棵 public/ 的 /blog/、/curio/、/daymark/ 下）。规则搬自 styrigx-atlas 的 root/_headers。
# /js/ /css/ 下由 Hugo Pipes 生成的文件名都带内容哈希（CI「Check site tree」核对子站产物里没有未指纹化的 /js/ 引用），长期缓存；
# 博客字体文件名不带指纹，缓存一周。页面 HTML 不写 Cache-Control（Pages 默认 max-age=0；经网关时改成 private, no-store）。
# 注意：上面 /* 的安全头（含 Report-Only CSP）也会合到子站静态响应上（代码方案风险 R6，待定 P4）。
/blog/css/*
  Cache-Control: public, max-age=31536000, immutable
/blog/js/*
  Cache-Control: public, max-age=31536000, immutable
/blog/fonts/*
  Cache-Control: public, max-age=604800
/curio/css/*
  Cache-Control: public, max-age=31536000, immutable
/curio/js/*
  Cache-Control: public, max-age=31536000, immutable
/daymark/css/*
  Cache-Control: public, max-age=31536000, immutable
/daymark/js/*
  Cache-Control: public, max-age=31536000, immutable
