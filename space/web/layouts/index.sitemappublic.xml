{{/* sitemap 只收录未登录返回 200 的公开页。
   公开页清单来自 data/public-pages.yaml（与 L1 middleware 的
   workers/auth-gateway/src/gate.js PUBLIC_PAGE_PATHS 共用数据源，tests/workers/auth-gateway/sitemap.test.mjs 保证同步）。
   锁住的页面（/security/、/account/ 等）一律不进 sitemap。
   P4-3 PR-4c：只在根上出一份（输出格式 sitemappublic，root: true）；中英两种语言各渲染一次但内容完全相同，谁后写都一样。 */}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{ range (index .Site.Data "public-pages").pages }}
  <url>
    <loc>{{ site.BaseURL }}{{ strings.TrimPrefix "/" . }}</loc>
  </url>
  {{ end }}
</urlset>
