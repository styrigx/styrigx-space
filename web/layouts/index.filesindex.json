{{/* 全站内容索引：/files-index.json —— 浏览器站内搜索用这一份数据（2026-10-19「我的文件」已删除） */}}
{{ $items := slice }}
{{ $langs := slice "zh" "en" }}
{{ $homeOf := dict "zh" "/" "en" "/en/" }}

{{/* ---------- 博客文章：CI 从博客仓库生成 data/posts.json，本地读取 ---------- */}}
{{ range $i, $p := $.Site.Data.posts }}
  {{ $id := printf "post-%d" (add $i 1) }}
  {{ if eq $p.lang "en" }}{{ $id = printf "post-%d-en" (add $i 1) }}{{ end }}
  {{ $items = $items | append (dict "id" $id "type" "post" "lang" $p.lang "title" $p.title "subtitle" "" "url" $p.url "cover" "" "addedAt" $p.date) }}
{{ end }}

{{/* ---------- 书签 ---------- */}}
{{ range $l := $langs }}
  {{ $links := cond (eq $l "en") site.Data.en.links site.Data.links }}
  {{ range $ci, $cat := $links }}
    {{ range $si, $s := $cat.sites }}
      {{ $id := printf "link-%d-%d" (add $ci 1) (add $si 1) }}
      {{ if eq $l "en" }}{{ $id = printf "link-%d-%d-en" (add $ci 1) (add $si 1) }}{{ end }}
      {{ $items = $items | append (dict "id" $id "type" "link" "lang" $l "title" $s.name "subtitle" $cat.category "url" $s.url "cover" "" "addedAt" "") }}
    {{ end }}
  {{ end }}
{{ end }}

{{/* ---------- 我的站点 ---------- */}}
{{/* 2.3.9：只有我编写、只有我有权限的站点（博客等） */}}
{{ range $l := $langs }}
  {{ $sites := cond (eq $l "en") site.Data.en.sites site.Data.sites }}
  {{ range $s := $sites }}
    {{ $id := printf "site-%s" $s.id }}
    {{ if eq $l "en" }}{{ $id = printf "site-%s-en" $s.id }}{{ end }}
    {{ $items = $items | append (dict "id" $id "type" "site" "lang" $l "title" $s.title "subtitle" ($s.subtitle | default "") "url" $s.url "cover" "" "addedAt" "") }}
  {{ end }}
{{ end }}

{{/* ---------- 应用 ---------- */}}
{{/* 系统 App（书签 / 设置）直接链接；B2-2 删除应用商店；2026-10-20 浏览器拆成 书签 + 全网搜索 */}}
{{ $apps := slice
  (dict "key" "bookmarks" "zh" "书签"    "en" "Bookmarks" "zhsub" "书签导航"       "ensub" "Bookmark directory"     "path" "bookmarks/")
  (dict "key" "settings" "zh" "设置"     "en" "Settings"  "zhsub" "主题、语言、壁纸" "ensub" "Theme, language, wallpaper" "path" "settings/")
}}
{{ range $l := $langs }}
  {{ range $a := $apps }}
    {{ $id := printf "app-%s" $a.key }}
    {{ if eq $l "en" }}{{ $id = printf "app-%s-en" $a.key }}{{ end }}
    {{ $items = $items | append (dict "id" $id "type" "app" "lang" $l "title" (index $a $l) "subtitle" (index $a (print $l "sub")) "url" (print (index $homeOf $l) $a.path) "cover" "" "addedAt" "") }}
  {{ end }}
{{ end }}

{{ (dict "generated" (now.Format "2006-01-02T15:04:05Z07:00") "items" $items) | jsonify }}
