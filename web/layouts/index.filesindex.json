{{/* 全站内容索引：/files-index.json —— 主站的站点 + 应用，scripts/build-search-index.mjs 读它写进搜索索引 site:space（博客文章由博客自己写 site:blog） */}}
{{ $items := slice }}
{{ $langs := slice "zh" "en" }}
{{ $homeOf := dict "zh" "/" "en" "/en/" }}

{{/* ---------- 站点（data/sites.yaml、data/en/sites.yaml） ---------- */}}
{{ range $l := $langs }}
  {{ $sites := cond (eq $l "en") site.Data.en.sites site.Data.sites }}
  {{ range $s := $sites }}
    {{ $id := printf "site-%s" $s.id }}
    {{ if eq $l "en" }}{{ $id = printf "site-%s-en" $s.id }}{{ end }}
    {{ $items = $items | append (dict "id" $id "type" "site" "lang" $l "title" $s.title "subtitle" ($s.subtitle | default "") "url" $s.url "cover" "" "addedAt" "") }}
  {{ end }}
{{ end }}

{{/* ---------- 应用 ---------- */}}
{{/* 系统 App（设置）直接链接；书签在子站 奇趣 curio.styrigx.com */}}
{{ $apps := slice
  (dict "key" "settings" "zh" "设置"     "en" "Settings"  "zhsub" "主题、语言、壁纸" "ensub" "Theme, language, wallpaper" "path" "settings/")
}}
{{ range $l := $langs }}
  {{ range $a := $apps }}
    {{ $id := printf "app-%s" $a.key }}
    {{ if eq $l "en" }}{{ $id = printf "app-%s-en" $a.key }}{{ end }}
    {{ $items = $items | append (dict "id" $id "type" "app" "lang" $l "title" (index $a $l) "subtitle" (index $a (print $l "sub")) "url" (print (index $homeOf $l) $a.path) "cover" "" "addedAt" "") }}
  {{ end }}
{{ end }}

{{ (dict "generated" (now.Format "2006-01-02T15:04:05Z07:00") "items" $items) | jsonify }}
