{
  "author": "Sloan Gray",
  "dependencies": {
    "tailwindcss": "4.3.5"
  },
  "description": "Styrigx's Space —— 一个按 One UI 9.0 写的个人网站，把网站做成一台手机。",
  "keywords": [
    "hugo",
    "tailwindcss",
    "one-ui",
    "personal-website"
  ],
  "license": "MIT",
  "name": "styrigx-space",
  "scripts": {
    "build:css": "node space/scripts/build/build-css.cjs --minify",
    "build": "node space/scripts/build/build-css.cjs --minify && hugo --minify --cleanDestinationDir -s space/web",
    "test:sites": "node --test tests/blog/*.test.mjs tests/curio/*.test.mjs tests/daymark/*.test.mjs tests/workers/curio-core/*.test.mjs tests/workers/daymark-core/*.test.mjs tests/workers/atlas/*.test.mjs"
  },
  "version": "3.0.0",
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/cli": "4.3.5",
    "http-server": "^14.1.1",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.16.0"
  },
  "overrides": {
    "follow-redirects": "^1.16.2",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}
